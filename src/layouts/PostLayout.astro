---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'posts'>;
  recentPosts: CollectionEntry<'posts'>[];
}

const { post, recentPosts } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div id="content">
    <article class="entry">
      <h1 class="entry-title">{post.data.title}</h1>
      <p class="entry-date">{post.data.pubDate.toISOString().slice(0, 10)}</p>
      <Content />
    </article>

    <aside class="sidenav">
      <h2>Recent</h2>
      <ul class="artical-list">
        {recentPosts.slice(0, 12).map(p => (
          <li><a href={`/${p.slug}`}>{p.data.title}</a></li>
        ))}
      </ul>
    </aside>
  </div>
</BaseLayout>

<style is:global>
  #content {
    width: 1060px; max-width: calc(100% - 40px * 2);
    margin: 100px auto 60px; min-height: 400px;
  }
  .entry {
    margin-bottom: 80px; width: 680px; float: left;
    background: var(--color-surface); padding: 2.5rem;
    border-radius: 12px; box-shadow: 0 1px 4px var(--color-shadow);
    min-height: 720px;
  }
  .entry-title { font-size: 2rem; font-weight: 700; margin-bottom: 8px; line-height: 1.3; }
  .entry-title a { color: var(--color-text); }
  .entry-date { text-align: center; color: var(--color-text-light); margin-bottom: 60px; font-size: 0.875rem; }
  .entry p { margin-bottom: 1.5em; line-height: 1.8; }
  .entry h2 { font-size: 1.5rem; font-weight: 700; margin: 2em 0 0.8em; }
  .entry h3 { font-size: 1.25rem; font-weight: 600; margin: 1.8em 0 0.6em; }
  .entry h4 { font-weight: 600; margin: 1.5em 0 0.5em; }
  .entry ul { margin-bottom: 1.5em; margin-left: 1.5em; }
  .entry ul li { margin-bottom: 0.3em; list-style: disc; line-height: 1.8; }
  .entry ol { margin-bottom: 1.5em; margin-left: 1.5em; }
  .entry ol li { margin-bottom: 0.3em; list-style: decimal; line-height: 1.8; }
  .entry blockquote {
    margin: 1.5em 0; padding: 0.8em 1.2em;
    border-left: 4px solid var(--color-link);
    background: var(--color-code-bg);
    border-radius: 0 6px 6px 0;
    font-size: 0.95rem; color: var(--color-text-secondary); font-style: italic;
  }
  .entry img { max-width: 100%; display: block; margin: 1.5em auto; border-radius: 8px; }
  .entry pre {
    font-family: var(--font-mono); background: var(--color-pre-bg);
    color: var(--color-pre-text); padding: 1.25rem 1.5rem;
    overflow-x: auto; margin-bottom: 1.5em;
    font-size: 0.85rem; line-height: 1.6;
    border-radius: 8px; border: 1px solid var(--color-border);
  }
  .entry code {
    background: var(--color-code-bg); border: 1px solid var(--color-border);
    padding: 0.15em 0.4em; border-radius: 4px; font-size: 0.85em;
  }
  .entry pre code { background: transparent; border: none; padding: 0; color: inherit; }
  .entry table { width: 100%; border-collapse: collapse; margin-bottom: 1.5em; font-size: 0.9rem; }
  .entry th, .entry td { border: 1px solid var(--color-border); padding: 0.5em 0.75em; text-align: left; }
  .entry th { background: var(--color-code-bg); font-weight: 600; }

  .sidenav {
    width: 240px; background: var(--color-surface);
    float: right; padding: 1.25rem; margin-bottom: 50px;
    border-radius: 12px; box-shadow: 0 1px 4px var(--color-shadow);
  }
  .sidenav h2 { font-size: 1.1rem; margin-bottom: 0.8rem; font-weight: 600; }
  .sidenav ul { margin-bottom: 2rem; }
  .sidenav li { margin-bottom: 0.6rem; word-break: break-all; }
  .sidenav a { color: var(--color-text-secondary); font-size: 0.875rem; display: block; }
  .sidenav a:hover { color: var(--color-link); text-decoration: none; }

  @media (max-width: 1020px) {
    .sidenav { display: none; }
    .entry { float: none; width: 100%; background: transparent; padding: 0; box-shadow: none; min-height: auto; }
    #content { width: 88%; max-width: 700px; margin: 80px auto 40px; }
  }
</style>
