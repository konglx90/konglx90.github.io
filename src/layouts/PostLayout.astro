---
import BaseLayout from './BaseLayout.astro';
import Clock from '../components/Clock';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'posts'>;
  recentPosts: CollectionEntry<'posts'>[];
}

const { post, recentPosts } = Astro.props;
const { Content } = await post.render();
const cats = { blog: 'Blog', opinion: 'Opinion', project: 'Project' };
const catSlugs = { blog: '/', opinion: '/opinion', project: '/project' };
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post-full">
    <header class="post-head">
      <a href={catSlugs[post.data.category]} class="post-cat">{cats[post.data.category]}</a>
      <h1 class="post-title">{post.data.title}</h1>
      <div class="post-meta">
        <time>{post.data.pubDate.toISOString().slice(0, 10)}</time>
        <span class="meta-dot">·</span>
        <span>{Math.ceil(post.body.length / 500) || 1} 分钟阅读</span>
      </div>
    </header>

    <div class="post-body">
      <Content />
    </div>

    <aside class="post-sidebar">
      <div class="sidebar-block">
        <h3>Recent</h3>
        <ul>
          {recentPosts.slice(0, 10).map(p => (
            <li><a href={`/${p.slug}`}>{p.data.title}</a></li>
          ))}
        </ul>
      </div>
    </aside>
  </article>

  <Clock client:load />
</BaseLayout>

<style is:global>
  .post-full {
    max-width: calc(var(--content-max) + 280px);
    margin: 0 auto;
    padding: 0 24px 80px;
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: flex-start;
  }

  /* ── Post Header ── */
  .post-head {
    width: 100%;
    padding: 48px 0 32px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0;
  }
  .post-cat {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-subtle);
    padding: 3px 12px;
    border-radius: 9999px;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .post-cat:hover { color: var(--accent-hover); }
  .post-head .post-title {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .post-meta {
    margin-top: 12px;
    font-size: 0.875rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }
  .meta-dot { margin: 0 6px; }

  /* ── Post Body ── */
  .post-body {
    flex: 1;
    min-width: 0;
    max-width: var(--content-max);
    padding-top: 32px;
  }
  .post-body h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 2.5em 0 0.8em;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .post-body h3 {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 2em 0 0.6em;
    line-height: 1.4;
  }
  .post-body h4 { font-weight: 600; margin: 1.5em 0 0.5em; }
  .post-body p {
    margin-bottom: 1.5em;
    line-height: 1.8;
    color: var(--text);
  }
  .post-body a { color: var(--accent); border-bottom: 1px solid transparent; }
  .post-body a:hover { border-bottom-color: var(--accent); }
  .post-body ul, .post-body ol {
    margin-bottom: 1.5em;
    padding-left: 1.5em;
  }
  .post-body ul li { list-style: disc; margin-bottom: 0.3em; line-height: 1.8; }
  .post-body ol li { list-style: decimal; margin-bottom: 0.3em; line-height: 1.8; }
  .post-body blockquote {
    margin: 2em 0;
    padding: 1em 1.5em;
    border-left: 3px solid var(--accent);
    background: var(--surface);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 0.95rem;
    color: var(--text-secondary);
    font-style: italic;
  }
  .post-body hr {
    margin: 3em 0;
    border: none;
    height: 1px;
    background: var(--border);
  }
  .post-body img {
    margin: 2em auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .post-body table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5em;
    font-size: 0.9rem;
  }
  .post-body th, .post-body td {
    border: 1px solid var(--border);
    padding: 0.5em 0.75em;
    text-align: left;
  }
  .post-body th { background: var(--surface-hover); font-weight: 600; }

  /* ── Code ── */
  .post-body code {
    font-family: var(--font-mono);
    background: var(--surface-hover);
    border: 1px solid var(--border);
    padding: 0.15em 0.45em;
    border-radius: 4px;
    font-size: 0.85em;
  }
  .post-body pre {
    font-family: var(--font-mono);
    background: #1a1a2e;
    color: #e4e4e7;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 2em 0;
    font-size: 0.85rem;
    line-height: 1.65;
    border-radius: var(--radius);
    border: 1px solid #2a2a3e;
    tab-size: 2;
  }
  .post-body pre code {
    background: transparent;
    border: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }
  @media (prefers-color-scheme: dark) {
    .post-body pre { background: #000000; border-color: var(--border); }
  }

  /* ── Sidebar ── */
  .post-sidebar {
    width: 240px;
    flex-shrink: 0;
    position: sticky;
    top: calc(var(--nav-height) + 32px);
    padding-top: 32px;
  }
  .sidebar-block {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
  }
  .sidebar-block h3 {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }
  .sidebar-block ul { display: flex; flex-direction: column; gap: 8px; }
  .sidebar-block li {}
  .sidebar-block a {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.4;
    display: block;
  }
  .sidebar-block a:hover { color: var(--accent); }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .post-sidebar { display: none; }
    .post-full { padding: 0 16px 60px; }
    .post-head .post-title { font-size: 1.6rem; }
    .post-head { padding: 32px 0 24px; }
  }
  /* ── Fixed Clock ── */
  .fixed-clock {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 9999px;
    padding: 6px 16px;
    box-shadow: var(--shadow-lg);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    z-index: 100;
    letter-spacing: 1px;
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .fixed-clock:hover { color: var(--accent); border-color: var(--accent); }

  @media (max-width: 640px) {
    .fixed-clock { bottom: 12px; right: 12px; padding: 4px 12px; font-size: 0.8rem; }
  }

</style>
