---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404">
  <div id="content">
    <div class="error-page">
      <div class="error-code">404</div>
      <p class="error-msg">很抱歉，您访问的页面不存在</p>
      <p class="error-desc">可能该文章已被删除，或者您访问了一个错误的链接</p>
      <a class="error-back" href="/">← 返回首页</a>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .error-page { text-align: center; padding: 80px 20px; min-height: 60vh; display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .error-code { font-size: 6rem; font-weight: 800; line-height: 1; color: var(--color-accent); margin-bottom: 16px; letter-spacing: 12px; }
  .error-msg { font-size: 1.25rem; color: var(--color-text-secondary); margin-bottom: 8px; }
  .error-desc { font-size: 0.95rem; color: var(--color-text-light); margin-bottom: 32px; }
  .error-back { display: inline-block; padding: 10px 28px; background: var(--color-link); color: #fff; border-radius: 6px; font-size: 0.95rem; }
  .error-back:hover { opacity: 0.9; text-decoration: none; }
  @media (max-width: 750px) { .error-code { font-size: 4rem; } .error-page { padding: 60px 20px; } }
</style>
