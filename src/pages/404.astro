---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404">
  <div class="error-page">
    <span class="error-code">404</span>
    <h1 class="error-title">页面不存在</h1>
    <p class="error-desc">该文章可能已被删除，或链接有误</p>
    <a href="/" class="error-btn">← 返回首页</a>
  </div>
</BaseLayout>

<style is:global>
  .error-page {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 120px 24px;
    text-align: center;
  }
  .error-code {
    font-size: 6rem;
    font-weight: 800;
    line-height: 1;
    color: var(--accent);
    letter-spacing: -0.04em;
    opacity: 0.3;
  }
  .error-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: -12px;
  }
  .error-desc {
    margin-top: 8px;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
  .error-btn {
    display: inline-block;
    margin-top: 32px;
    padding: 10px 28px;
    background: var(--accent);
    color: #fff;
    border-radius: 9999px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: opacity 0.2s;
  }
  .error-btn:hover { opacity: 0.85; color: #fff; }
  @media (max-width: 640px) {
    .error-page { padding: 80px 16px; }
    .error-code { font-size: 4rem; }
  }
</style>
