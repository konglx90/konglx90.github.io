---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter(p => p.data.category === 'project')
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title="Project">
  <div class="page-header">
    <h1 class="page-title">Project</h1>
    <p class="page-desc">项目记录</p>
  </div>

  <div class="post-list">
    {posts.map(post => (
      <article class="post-card">
        <time class="post-date">{post.data.pubDate.toISOString().slice(0, 10)}</time>
        <h2 class="post-title"><a href={`/${post.slug}`}>{post.data.title}</a></h2>
        {post.data.description && post.data.description.length > 0 && (
          <p class="post-desc">{post.data.description}</p>
        )}
      </article>
    ))}
  </div>
</BaseLayout>

<style is:global>
  .page-header { max-width: var(--content-max); margin: 0 auto; padding: 60px 24px 40px; }
  .page-title { font-size: 2.25rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1.2; }
  .page-desc { margin-top: 8px; font-size: 1.05rem; color: var(--text-secondary); }
  .post-list { max-width: var(--content-max); margin: 0 auto; padding: 0 24px 60px; display: flex; flex-direction: column; gap: 8px; }
  .post-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px 28px; transition: all 0.2s; }
  .post-card:hover { border-color: var(--accent); box-shadow: var(--shadow-lg); }
  .post-date { font-size: 0.8rem; color: var(--text-muted); font-family: var(--font-mono); letter-spacing: 0.02em; }
  .post-title { margin-top: 6px; font-size: 1.125rem; font-weight: 600; line-height: 1.4; }
  .post-title a { color: var(--text); }
  .post-title a:hover { color: var(--accent); }
  .post-desc { margin-top: 8px; font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6; }
  @media (max-width: 640px) {
    .page-header { padding: 40px 16px 28px; }
    .page-title { font-size: 1.75rem; }
    .post-list { padding: 0 16px 40px; }
    .post-card { padding: 18px 20px; }
  }
</style>
